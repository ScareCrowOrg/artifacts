# Vite Compilation Service - Artifacts Directory
# This directory serves dynamic cell/book types via Vite Dev Server

# Ignore all runtime artifacts (user-generated content, session data)
runtime/*
!runtime/.gitkeep
!runtime/README.md

# Ignore all sandbox artifacts (user-private, draft data - NEVER published)
# PRIVACY GUARANTEE: Sandbox data stays local and is never committed to Git
sandbox/*
!sandbox/.gitkeep
!sandbox/README.md

# Node modules (Vite dependencies)
node_modules/

# Vite cache and build artifacts
.vite/
dist/
dist-ssr/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lock files (we use package-lock.json in root)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment variables
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# ========================================
# BUILD & DEPENDENCY ARTIFACTS
# ========================================
# Keep full source but ignore build artifacts and dependencies
# Launcher needs all canonical/ content to function

# Python virtual environments (installed locally, not distributed)
venv/
.venv/
env/
.env.venv

# Python build/cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Node modules (reinstalled per environment)
node_modules/
.npm/

# Test/cache directories
.pytest_cache/
.coverage
.venv/
*.egg

# IDE/temp
.venv_backup/
.DS_Store

# ========================================
# SERVICE BUILD ARTIFACTS (NEVER COMMIT)
# ========================================
# Backend service source code should NOT be staged into artifacts/
# Dockerfile uses BACKEND_SRC_PATH=backend to copy from monorepo root
# If staged here accidentally, git subtree would sync 9k+ files
canonical/services/backend/src/
