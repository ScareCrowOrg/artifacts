{
  "version": "0.1",
  "name": "scare-registry-gate",
  "build": false,
  "image": "hub.scareverse.net/registry/production/scareverse-scare-registry-gate:prod",
  "generate_env_file": false,
  "totp_seed": false,
  "injected_env_vars": [
    {
      "name": "R2_ACCOUNT_ID",
      "source": "vault",
      "required": true,
      "description": "Cloudflare R2 account ID"
    },
    {
      "name": "R2_ACCESS_KEY_ID",
      "source": "vault",
      "required": true,
      "description": "R2 S3-compatible access key"
    },
    {
      "name": "R2_SECRET_ACCESS_KEY",
      "source": "vault",
      "required": true,
      "description": "R2 S3-compatible secret key"
    },
    {
      "name": "CENTRALHUB_URL",
      "source": "config",
      "required": true,
      "description": "CentralHub base URL"
    },
    {
      "name": "CENTRALHUB_SERVICE_TOKEN",
      "source": "vault",
      "required": true,
      "description": "Service token for CentralHub API"
    },
    {
      "name": "CONTROL_API_KEY",
      "source": "vault",
      "required": false,
      "description": "API key for the control-plane endpoint (PUT/DELETE tenant-session)"
    },
    {
      "name": "R2_BUCKET",
      "source": "config",
      "required": true,
      "description": "Cloudflare R2 bucket name for image storage"
    },
    {
      "name": "R2_PUBLIC_URL",
      "source": "config",
      "required": true,
      "description": "Public base URL for R2 blobs (for pull redirects)"
    }
  ],
  "dependencies": [],
  "imageTag": "prod",
  "lastBuilt": {
    "staging": "2026-07-21T02:19:58.257Z",
    "production": "2026-08-20T20:13:03.899Z"
  },
  "planet": "production"
}
