# Example environment configuration
# Copy this file to .env and adjust as needed

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Logging
LOG_LEVEL=INFO

# HTTP Client Configuration
# Global timeouts for HTTP connections (in seconds)
# These prevent hanging indefinitely when external services don't respond
HTTP_CONNECTION_TIMEOUT=10.0  # Time to establish connection
HTTP_READ_TIMEOUT=30.0         # Time to receive response after connection

# Authentication (future feature)
AUTH_ENABLED=false
AUTH_TOKEN=

# Google OAuth2 Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Create OAuth 2.0 credentials for your application
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS Origins (comma-separated)
# Use * for development, specific origins for production
# CORS_ORIGINS=*
# CORS_ORIGINS=chrome-extension://your-extension-id,http://localhost:3000

# Ollama Configuration
# URL of the local Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
# Model to use for chat (default: mistral)
# Other options: mistral, deepseek, phi
OLLAMA_MODEL=mistral
# Timeout in seconds for Ollama API calls
OLLAMA_TIMEOUT=30

# RAG and Embeddings Configuration (Ollama-based)
# Model to use for document embeddings (local models via Ollama)
# Supported models: mistral, phi, deepseek-coder
# To use: Install Ollama (https://ollama.ai/) and pull the model: ollama pull mistral
OLLAMA_EMBEDDING_MODEL=mistral
# Path to ChromaDB vector store (relative to BASE_DIR)
VECTORSTORE_PATH=chroma_db
# ChromaDB collection name for documents
VECTORSTORE_COLLECTION=scareverse_docs
# Document chunking configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Post-processing Configuration (Local LLM)
# Enable/disable intelligent post-processing of RAG context with a local LLM
# When enabled, retrieved chunks are condensed and filtered before being sent to the main LLM
# This can significantly reduce token usage and improve response quality
RAG_POSTPROCESS_LLM_ENABLED=false
# Local LLM model to use for post-processing (via Ollama)
# Recommended: phi3:latest (fast and efficient), mistral, or other Ollama models
# To use: Install Ollama and pull the model: ollama pull phi3:latest
RAG_POSTPROCESS_LLM_MODEL=phi3:latest
# Prompt template for post-processing (optional, uses default if not set)
# Available placeholders: {context}, {query}
# RAG_POSTPROCESS_LLM_PROMPT="Your custom prompt here..."

# Gemini API Configuration (Google Generative AI)
# Get your API key from: https://makersuite.google.com/app/apikey
# Leave empty to disable Gemini integration
GEMINI_API_KEY=
# Gemini API base URL (usually no need to change)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# Timeout in seconds for Gemini API calls
GEMINI_TIMEOUT=30

# MongoDB Configuration
# Enable MongoDB for runtime data storage (celulas, livros, sessoes, etc.)
# When disabled, all data uses file-based storage
MONGODB_ENABLED=false
# MongoDB connection settings
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=scareverse
# MongoDB authentication (optional in development, required in production)
MONGODB_USERNAME=scareverse
MONGODB_PASSWORD=your-secure-password

# =============================================================================
# Redis Configuration (L1 Local Cache & L2 Cluster Cache)
# =============================================================================
# Phase 1B: Explicit L1/L2 separation for local-first architecture
# - L1: Local cache (direct connection from ScareRunner)
# - L2: Cluster cache (access via CentralHubClient HTTP only)

# Redis L1 (Local Cache) - Direct connection
REDIS_L1_ENABLED=false
REDIS_L1_HOST=redis-local
REDIS_L1_PORT=6380
REDIS_L1_DB=0
REDIS_L1_PASSWORD=scarerunner

# Redis L2 (Cluster Cache) - HTTP access only via CentralHubClient
REDIS_L2_ENABLED=false
REDIS_L2_HOST=host.docker.internal
REDIS_L2_PORT=6379
REDIS_L2_DB=0
REDIS_L2_PASSWORD=

# Redis Cache Configuration
# Enable Redis-based caching for database operations
REDIS_CACHE_ENABLED=false
# Cache TTL (time-to-live) in seconds
REDIS_CACHE_TTL=3600              # Default: 1 hour
REDIS_CACHE_TTL_CELULAS=1800      # Celulas: 30 minutes
REDIS_CACHE_TTL_LIVROS=1800       # Livros: 30 minutes
REDIS_CACHE_TTL_CONFIG=300        # Config: 5 minutes
REDIS_CACHE_TTL_CANONICAL=7200    # Canonical data: 2 hours

# HybridDatabase Configuration
# HybridDatabase intelligently routes data between file system and MongoDB
# - Canonical data (types, templates) → Always file system
# - Runtime data (celulas, livros, sessoes) → MongoDB when enabled, otherwise file system
# - Redis coordination for cache synchronization and distributed locking
# No additional configuration needed - routing is automatic based on collection type

# ChromaDB Telemetry Configuration
# ChromaDB uses PostHog for anonymous usage telemetry by default
# Set to false to disable telemetry and prevent external network calls to posthog.com
ANONYMIZED_TELEMETRY=false

# Stable Diffusion Configuration
# URL of the Stable Diffusion API service (SD-Forge)
#
# IMPORTANT FOR KIND ON WSL2:
# The service DNS name 'sd-api' does NOT work reliably in KinD on WSL2 due to
# networking limitations with ExternalName services and host.docker.internal resolution.
#
# SOLUTION FOR KIND ON WSL2:
# 1. Detect your Windows host IP from WSL2:
#    bash infrastructure/local/scripts/helpers/detect-windows-host-ip.sh
# 2. Use the detected IP address directly (example):
#    STABLE_DIFFUSION_URL=http://172.24.240.1:7860
# 3. Ensure SD-Forge is running with --listen flag on Windows host:
#    cd C:\SDForge && .\webui-user.bat
#
# For local development (non-KinD, running backend directly): Use 'localhost'
#    STABLE_DIFFUSION_URL=http://localhost:7860
#
# The IP address typically looks like 172.x.x.x and is the Windows host IP
# as seen from WSL2. This IP can change after Windows reboots.
#
# Setup instructions: scripts/setup-sd.ps1
STABLE_DIFFUSION_URL=http://localhost:7860

# Timeout in seconds for Stable Diffusion API calls
# Default: 120 seconds (2 minutes)
# Adjust based on model complexity and hardware:
#   - Simple/Turbo models with good GPU: 60-120s
#   - Complex SDXL models or limited GPU: 180-300s
STABLE_DIFFUSION_TIMEOUT=120

# Stable Fast 3D API Configuration (Stability AI)
# API key for Stable Fast 3D service
# Get your API key from: https://platform.stability.ai/
# Leave empty to disable cloud-api mode for 3D mesh generation
STABLE_FAST_3D_API_KEY=
# Stable Fast 3D API endpoint (using v2beta as v1 is deprecated)
STABLE_FAST_3D_URL=https://api.stability.ai/v2beta/3d/stable-fast-3d
# Timeout in seconds for Stable Fast 3D API calls
# Default: 60 seconds (3D generation is typically fast ~1-5s on their servers)
STABLE_FAST_3D_TIMEOUT=60
