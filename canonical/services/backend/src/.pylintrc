# Pylint Configuration for ScareVerse Backend
# Aligned with RULESET.md and Python best practices

[MASTER]
# Add project root to Python path for proper imports
init-hook='import sys; sys.path.insert(0, ".")'

# Load pylint-pydantic plugin for enhanced Pydantic model validation
# This plugin adds hinters to help Pylint understand Pydantic's metaclasses and dynamic attributes
# It enables detection of invalid field access while avoiding false positives on valid Pydantic patterns
load-plugins=pylint_pydantic

# Use multiple processes for faster linting
jobs=4

# Pickle collected data for faster re-runs
persistent=yes

# Allow loading of arbitrary C extensions
unsafe-load-any-extension=no

# Python version to target
py-version=3.10

[MESSAGES CONTROL]
# Focus on critical errors (E****) and fatal (F****)
# Disable conventions (C****), refactoring (R****), and warnings (W****) for now
# These can be enabled incrementally after fixing critical issues
disable=
    C,  # Convention violations (code style)
    R,  # Refactoring suggestions (complexity, duplication)
    W,  # Warnings (non-critical issues)
    no-name-in-module,  # E0611 - Too many false positives with app.config package structure
    import-error,  # E0401 - Disable for modules that exist but Pylint can't find
    
# Keep enabled:
# E**** - Errors (logic issues, undefined variables except module imports)
# F**** - Fatal (syntax errors, critical failures)

[REPORTS]
# Simplify output for CI/CD
output-format=colorized
reports=no
score=yes

[TYPECHECK]
# Handle Pydantic models and dynamic attributes
# With pylint-pydantic plugin loaded, we can safely validate Pydantic models
# The plugin provides type hints that prevent false positives while catching real errors

# Ignore members generated by Pydantic and other frameworks
generated-members=
    pydantic.*,
    Field.*,
    BaseModel.*,
    model_validate,
    model_dump,
    model_fields,
    
# Ignore missing members in external libraries that use dynamic attributes
ignored-modules=
    langchain,
    langchain_core,
    langchain_community,
    chromadb,
    motor,
    pymongo,
    
# Classes for which member attributes should not be checked
# NOTE: With pylint-pydantic plugin, we can remove FieldInfo, Field, and BaseModel
# from this list as the plugin handles Pydantic validation correctly
# Only keep classes from external libraries that cause false positives
ignored-classes=
    Chroma,
    ConfigOperations,
    CRUDOperations,

[BASIC]
# Naming conventions (RULESET.md Rule 4.3: English names)
# Allow short variable names in comprehensions
good-names=i,j,k,ex,_,id,db,logger

# Regular expression matching correct function names (snake_case)
function-rgx=[a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct variable names (snake_case)
variable-rgx=[a-z_][a-z0-9_]{0,50}$

# Regular expression matching correct constant names (UPPER_CASE)
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$

# Regular expression matching correct class names (PascalCase)
class-rgx=[A-Z_][a-zA-Z0-9]+$

# Regular expression matching correct module names (snake_case)
module-rgx=(([a-z_][a-z0-9_]*)|([A-Z][a-zA-Z0-9]+))$

[FORMAT]
# Maximum line length (align with Black/PEP 8)
max-line-length=120

# Maximum number of lines in a module (RULESET.md Rule 1.1)
max-module-lines=500

[DESIGN]
# Maximum number of arguments for functions
max-args=10

# Maximum number of attributes for classes
max-attributes=15

# Maximum number of public methods for classes
max-public-methods=25

[IMPORTS]
# Allow wildcard imports in __init__.py for re-exports
allow-wildcard-with-all=yes

[SIMILARITIES]
# Minimum lines of similar code to report (DRY principle)
min-similarity-lines=10

# Ignore imports when checking for duplicated code
ignore-imports=yes
