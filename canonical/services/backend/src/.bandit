# Bandit configuration for ScareVerse Backend SAST
# https://bandit.readthedocs.io/en/latest/config.html

# Exclude test directories and virtual environments
exclude_dirs:
  - /tests/
  - /venv/
  - /.venv/
  - /__pycache__/
  - /node_modules/

# Skip specific tests (empty by default - all tests enabled)
skips: []

# Tests to run - focus on critical security issues
# Full list: https://bandit.readthedocs.io/en/latest/plugins/index.html
tests:
  - B201  # flask_debug_true - Flask app with debug=True
  - B301  # pickle - Pickle usage (can execute arbitrary code)
  - B302  # marshal - Marshal usage (unsafe deserialization)
  - B303  # md5 - Use of insecure MD5 hash function
  - B304  # insecure_cipher - Use of insecure cipher
  - B305  # insecure_cipher_mode - Use of insecure cipher mode
  - B306  # mktemp_q - Use of mktemp
  - B307  # eval - Use of eval()
  - B308  # mark_safe - Use of mark_safe (XSS risk)
  - B310  # urllib_urlopen - Audit url open for permitted schemes
  - B601  # paramiko_calls - Paramiko usage
  - B602  # subprocess_popen_with_shell_equals_true - Shell injection
  - B603  # subprocess_without_shell_equals_true - Check for untrusted input
  - B604  # any_other_function_with_shell_equals_true - Shell injection
  - B605  # start_process_with_a_shell - Shell injection
  - B606  # start_process_with_no_shell - Process execution
  - B607  # start_process_with_partial_path - Partial path for process execution
  - B608  # hardcoded_sql_expressions - SQL injection
  - B609  # linux_commands_wildcard_injection - Wildcard injection
  - B610  # django_extra_used - Django extra() use
  - B611  # django_rawsql_used - Django RawSQL use
  - B701  # jinja2_autoescape_false - Jinja2 autoescape disabled
  - B702  # use_of_mako_templates - Use of Mako templates
  - B703  # django_mark_safe - Django mark_safe usage

# Severity levels: LOW, MEDIUM, HIGH
# Report only MEDIUM and HIGH by default
# Use -ll flag to filter only HIGH severity

# Confidence levels: LOW, MEDIUM, HIGH
# Report only MEDIUM and HIGH confidence by default
# Use -ii flag to filter only HIGH confidence

# Generate reports in multiple formats:
# JSON: bandit -r app -f json -o bandit_report.json
# HTML: bandit -r app -f html -o bandit_report.html
# Screen: bandit -r app -f screen
# CSV: bandit -r app -f csv -o bandit_report.csv
