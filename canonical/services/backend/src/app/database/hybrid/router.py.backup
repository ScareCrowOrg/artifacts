"""
HybridDatabase Router - Intelligent routing between file-based and MongoDB storage.

Routes canonical data to file system (JSONDatabase) and runtime data to MongoDB,
with Redis coordination for cache synchronization and atomic operations.

Phase 1B Features:
- Sandbox operations (user-private, local-only artifacts)
- Unified L1 cache facade (merges sandbox + canonical + MongoDB)
- CentralHub client integration for MongoDB proxy
- Scope parameter (sandbox vs published)
"""

import logging
from typing import Optional, List, Dict, Any, Type, TypeVar
from pathlib import Path
from pydantic import BaseModel

from ..connection import JSONDatabase
from ..mongodb.operations import MongoDBOperations
from ..redis_cache import RedisCachedJSONDatabase
from ..centralhub_client import CentralHubClient
from ...config.database import MONGODB_ENABLED
from .collections import CANONICAL_COLLECTIONS, RUNTIME_COLLECTIONS
from .fallback import FallbackMixin
from .phase1b_mixin import Phase1BMixin

logger = logging.getLogger(__name__)

T = TypeVar("T", bound=BaseModel)


class HybridDatabase(Phase1BMixin, FallbackMixin):
    """
    Hybrid database router that intelligently routes operations between
    file-based storage (JSONDatabase) and MongoDB based on data classification.

    Design:
    - Canonical data (templates, types, configs) → File system (git-managed)
    - Runtime data (user cells, sessions, memory) → MongoDB (when enabled)
    - Sandbox data (user-private drafts) → Local disk (artifacts/sandbox/)
    - Redis L1 coordination for unified cache (sandbox + canonical + MongoDB)
    - CentralHub proxy for MongoDB operations
    - Graceful fallback to file storage if MongoDB unavailable

    Phase 1B Features:
    - Sandbox operations via Phase1BMixin
    - Unified L1 cache facade
    - Scope parameter (sandbox vs published)
    - publish_artifact workflow

    Usage:
        db = HybridDatabase()

        # Canonical data - always goes to file system
        db.insert("notebook_item_types", tipo_model, is_canonical=True)

        # Runtime data - goes to MongoDB if enabled, otherwise file system
        db.insert("cells", celula_model, usuario_id="user123", sessao_id="sess456")

        # Sandbox data (Phase 1B) - goes to sandbox/{user_id}/
        db.insert_with_scope("artifacts", artifact_dict, user_id="user123", scope="sandbox")

        # Published data (Phase 1B) - goes to MongoDB via CentralHub
        db.insert_with_scope("artifacts", artifact_dict, user_id="user123", scope="published")
    """

    def __init__(
        self,
        base_path: Optional[Path] = None,
        is_test_env: bool = False,
        redis_client=None,
        centralhub_client: Optional[CentralHubClient] = None,
    ):
        """
        Initialize the hybrid database router.

        Args:
            base_path: Base path for artifact storage (for file-based storage)
            is_test_env: Flag to indicate if running in a test environment
            redis_client: Redis client for L1 unified cache (Phase 1B)
            centralhub_client: CentralHub HTTP client for MongoDB proxy (Phase 1B)
        """
        self.is_test_env = is_test_env

        # Initialize file-based database (with Redis caching if enabled)
        self._file_db = RedisCachedJSONDatabase(base_path=base_path, is_test_env=is_test_env)

        # Initialize MongoDB operations (will be None if MongoDB disabled)
        self._mongo_ops: Optional[MongoDBOperations] = None
        if MONGODB_ENABLED:
            self._mongo_ops = MongoDBOperations()
            logger.info("HybridDatabase initialized with MongoDB support")
        else:
            logger.info("HybridDatabase initialized with file-only storage (MongoDB disabled)")

        # Initialize Phase 1B components (sandbox + unified cache)
        self._init_phase1b_components(
            redis_client=redis_client,
            centralhub_client=centralhub_client,
        )
        logger.info("HybridDatabase Phase 1B features initialized")

    def _should_use_mongodb(self, collection: str, is_canonical: bool = False) -> bool:
        """
        Determine if an operation should use MongoDB or file system.

        Args:
            collection: Collection name
            is_canonical: Whether this is explicitly marked as canonical

        Returns:
            True if should use MongoDB, False if should use file system

        Raises:
            RuntimeError: If runtime collection requires MongoDB but it's not available (in non-test env)
        """
        # Canonical data always goes to file system
        if is_canonical or collection in CANONICAL_COLLECTIONS:
            return False

        # Runtime collections: use MongoDB if available, otherwise route via CentralHub HTTP
        if collection in RUNTIME_COLLECTIONS:
            if MONGODB_ENABLED and self._mongo_ops:
                return True
            else:
                # In test environment, allow fallback to file system for runtime collections
                if self.is_test_env:
                    logger.debug(
                        f"Test environment: allowing file-based storage for runtime collection '{collection}'"
                    )
                    return False

                # Phase 1B: Route via CentralHub HTTP when MongoDB is disabled
                logger.debug(
                    f"MongoDB disabled - routing runtime collection '{collection}' via CentralHub HTTP"
                )
                return False

        # Unknown collections - log warning and use file system
        logger.warning(
            f"Unknown collection '{collection}' (not in CANONICAL_COLLECTIONS or RUNTIME_COLLECTIONS). "
            f"Defaulting to file-based storage."
        )
        return False

    def _apply_legacy_adapter(
        self,
        collection: str,
        document: Optional[BaseModel] = None,
        query: Optional[Dict[str, Any]] = None,
    ) -> tuple[str, Optional[BaseModel], Optional[Dict[str, Any]]]:
        """
        Legacy adapter: Convert old collection names to unified collection.

        Provides backward compatibility for code using legacy collection names:
        - "cells" → "notebook_items" + kind="cell"
        - "books" → "notebook_items" + kind="book"

        This enables legacy code to work without modifications while routing
        to the unified notebook_items collection.

        Args:
            collection: Original collection name
            document: Pydantic model instance (for insert/update operations)
            query: Query filter dictionary (for find operations)

        Returns:
            Tuple of (converted_collection, converted_document, converted_query)
        """
        if collection == "cells":
            # Convert to notebook_items + add kind discriminator
            logger.debug(f"Legacy adapter: routing 'cells' → 'notebook_items' with kind='cell'")
            
            if document:
                # Add kind field to document
                # Note: This works best with models that either:
                # 1. Have a 'kind' field defined
                # 2. Have model_config with extra='allow'
                # For models without these, the kind field may not persist to MongoDB.
                # Production models should include an optional kind field.
                try:
                    # Try to set kind attribute (works if model allows it)
                    if hasattr(document, "kind"):
                        document.kind = "cell"
                    else:
                        # Try setting anyway (works with extra='allow')
                        setattr(document, "kind", "cell")
                        logger.debug("Added kind='cell' to document")
                except Exception as e:
                    logger.warning(
                        f"Could not add kind field to document model {type(document).__name__}: {e}. "
                        f"Ensure production models include an optional 'kind' field."
                    )

            if query is not None:
                # Add kind filter to query
                query = {**query, "kind": "cell"}

            return "notebook_items", document, query

        elif collection == "books":
            # Convert to notebook_items + add kind discriminator
            logger.debug(f"Legacy adapter: routing 'books' → 'notebook_items' with kind='book'")
            
            if document:
                # Add kind field to document (see note above for cells)
                try:
                    if hasattr(document, "kind"):
                        document.kind = "book"
                    else:
                        setattr(document, "kind", "book")
                        logger.debug("Added kind='book' to document")
                except Exception as e:
                    logger.warning(
                        f"Could not add kind field to document model {type(document).__name__}: {e}. "
                        f"Ensure production models include an optional 'kind' field."
                    )

            if query is not None:
                # Add kind filter to query
                query = {**query, "kind": "book"}

            return "notebook_items", document, query

        # No conversion needed for other collections
        return collection, document, query

    async def insert(
        self,
        collection: str,
        document: BaseModel,
        user_id: Optional[str] = None,
        session_id: Optional[str] = None,
        is_canonical: bool = False,
    ) -> Optional[str]:
        """
        Insert a document into the appropriate backend.

        Args:
            collection: Collection name
            document: Pydantic model instance to insert
            user_id: User ID (for runtime data)
            session_id: Session ID (for runtime data)
            is_canonical: Whether this is canonical data

        Returns:
            Document ID or None if insert failed
        """
        # Apply legacy adapter first
        collection, document, _ = self._apply_legacy_adapter(collection, document)
        
        if self._should_use_mongodb(collection, is_canonical):
            logger.debug(f"Routing insert to MongoDB: {collection}")
            result = await self._mongo_ops.insert(
                collection=collection,
                document=document,
                user_id=user_id,
                session_id=session_id,
                is_canonical=False,
            )

            # Also invalidate Redis cache after MongoDB write
            if result:
                await self._file_db._invalidate_collection_cache(
                    collection=collection, user_id=user_id
                )

            return result
        else:
            logger.debug(f"Routing insert to file system: {collection}")
            # Use async insert from RedisCachedJSONDatabase
            return await self._file_db.insert_async(
                collection=collection,
                document=document,
                user_id=user_id,
                session_id=session_id,
                is_canonical=is_canonical,
            )

    async def find_one(
        self,
        collection: str,
        doc_id: str,
        model_class: Optional[Type[T]] = None,
        user_id: Optional[str] = None,
        session_id: Optional[str] = None,
        is_canonical: bool = False,
    ) -> Optional[T]:
        """
        Find a single document by ID.

        Args:
            collection: Collection name
            doc_id: Document ID
            model_class: Pydantic model class for deserialization
            user_id: User ID (for runtime data)
            session_id: Session ID (for runtime data)
            is_canonical: Whether this is canonical data

        Returns:
            Document instance or None if not found
        """
        # Apply legacy adapter first
        collection, _, _ = self._apply_legacy_adapter(collection)
        
        if self._should_use_mongodb(collection, is_canonical):
            logger.debug(f"Routing find_one to MongoDB: {collection}/{doc_id}")
            return await self._mongo_ops.find_one(
                collection=collection,
                doc_id=doc_id,
                model_class=model_class,
                user_id=user_id,
                session_id=session_id,
            )
        else:
            logger.debug(f"Routing find_one to file system: {collection}/{doc_id}")
            return await self._file_db.find_one_async(
                collection=collection,
                doc_id=doc_id,
                model_class=model_class,
                user_id=user_id,
                session_id=session_id,
                is_canonical=is_canonical,
            )

    async def find_many(
        self,
        collection: str,
        model_class: Optional[Type[T]] = None,
        user_id: Optional[str] = None,
        is_canonical: bool = False,
        limit: Optional[int] = None,
    ) -> List[T]:
        """
        Find multiple documents in a collection.

        Args:
            collection: Collection name
            model_class: Pydantic model class for deserialization
            user_id: User ID (for runtime data)
            is_canonical: Whether this is canonical data
            limit: Maximum number of documents to return

        Returns:
            List of document instances
        """
        # Apply legacy adapter first
        collection, _, _ = self._apply_legacy_adapter(collection)
        
        if self._should_use_mongodb(collection, is_canonical):
            logger.debug(f"Routing find_many to MongoDB: {collection}")
            return await self._mongo_ops.find_many(
                collection=collection, model_class=model_class, user_id=user_id, limit=limit
            )
        else:
            logger.debug(f"Routing find_many to file system: {collection}")
            return await self._file_db.find_many_async(
                collection=collection,
                model_class=model_class,
                user_id=user_id,
                is_canonical=is_canonical,
                limit=limit,
            )

    async def update(
        self,
        collection: str,
        doc_id: str,
        updates: Dict[str, Any],
        user_id: Optional[str] = None,
        session_id: Optional[str] = None,
        is_canonical: bool = False,
    ) -> bool:
        """
        Update a document in the appropriate backend.

        Args:
            collection: Collection name
            doc_id: Document ID
            updates: Dictionary of field updates
            user_id: User ID (for runtime data)
            session_id: Session ID (for runtime data)
            is_canonical: Whether this is canonical data

        Returns:
            True if update successful, False otherwise
        """
        # Apply legacy adapter first
        collection, _, _ = self._apply_legacy_adapter(collection)
        
        if self._should_use_mongodb(collection, is_canonical):
            logger.debug(f"Routing update to MongoDB: {collection}/{doc_id}")
            result = await self._mongo_ops.update(
                collection=collection,
                doc_id=doc_id,
                updates=updates,
                user_id=user_id,
                session_id=session_id,
            )

            # Invalidate cache after MongoDB write
            if result:
                await self._file_db._invalidate_collection_cache(
                    collection=collection, user_id=user_id
                )

            return result
        else:
            logger.debug(f"Routing update to file system: {collection}/{doc_id}")
            return await self._file_db.update_async(
                collection=collection,
                doc_id=doc_id,
                updates=updates,
                user_id=user_id,
                session_id=session_id,
                is_canonical=is_canonical,
            )

    async def delete(
        self,
        collection: str,
        doc_id: str,
        user_id: Optional[str] = None,
        session_id: Optional[str] = None,
        is_canonical: bool = False,
    ) -> bool:
        """
        Delete a document from the appropriate backend.

        Args:
            collection: Collection name
            doc_id: Document ID
            user_id: User ID (for runtime data)
            session_id: Session ID (for runtime data)
            is_canonical: Whether this is canonical data

        Returns:
            True if delete successful, False otherwise
        """
        # Apply legacy adapter first
        collection, _, _ = self._apply_legacy_adapter(collection)
        
        if self._should_use_mongodb(collection, is_canonical):
            logger.debug(f"Routing delete to MongoDB: {collection}/{doc_id}")
            result = await self._mongo_ops.delete(
                collection=collection, doc_id=doc_id, user_id=user_id, session_id=session_id
            )

            # Invalidate cache after MongoDB write
            if result:
                await self._file_db._invalidate_collection_cache(
                    collection=collection, user_id=user_id
                )

            return result
        else:
            logger.debug(f"Routing delete to file system: {collection}/{doc_id}")
            return await self._file_db.delete_async(
                collection=collection,
                doc_id=doc_id,
                user_id=user_id,
                session_id=session_id,
                is_canonical=is_canonical,
            )

    async def find_by_field(
        self,
        collection: str,
        field: str,
        value: Any,
        model_class: Optional[Type[T]] = None,
        user_id: Optional[str] = None,
        session_id: Optional[str] = None,
        is_canonical: bool = False,
    ) -> Optional[T]:
        """
        Find a document by field value.

        Args:
            collection: Collection name
            field: Field name to search
            value: Field value to match
            model_class: Pydantic model class for deserialization
            user_id: User ID (for runtime data)
            session_id: Session ID (for runtime data)
            is_canonical: Whether this is canonical data

        Returns:
            First matching document or None
        """
        # Apply legacy adapter first (create a query for kind filter)
        original_query = {field: value}
        collection, _, query = self._apply_legacy_adapter(collection, query=original_query)
        
        # If adapter added kind filter (query modified), use find_by_fields to handle multiple fields
        if query is not None and query != original_query:
            # Query has been modified by adapter (includes kind field)
            # Use find_by_fields to handle multiple fields
            if self._should_use_mongodb(collection, is_canonical):
                logger.debug(f"Routing find_by_field to MongoDB: {collection} with {query}")
                return await self._mongo_ops.find_by_fields(
                    collection=collection,
                    fields=query,
                    model_class=model_class,
                )
            else:
                logger.debug(f"Routing find_by_field to file system: {collection} with {query}")
                return await self._file_db.find_by_fields_async(
                    collection=collection,
                    fields=query,
                    model_class=model_class,
                    is_canonical=is_canonical,
                )
        else:
            # No adapter modification, use original find_by_field
            if self._should_use_mongodb(collection, is_canonical):
                logger.debug(f"Routing find_by_field to MongoDB: {collection}.{field}={value}")
                return await self._mongo_ops.find_by_field(
                    collection=collection,
                    field=field,
                    value=value,
                    model_class=model_class,
                    user_id=user_id,
                    session_id=session_id,
                )
            else:
                logger.debug(f"Routing find_by_field to file system: {collection}.{field}={value}")
                return await self._file_db.find_by_field_async(
                    collection=collection,
                    field=field,
                    value=value,
                    model_class=model_class,
                    is_canonical=is_canonical,
                )

    async def find_by_fields(
        self,
        collection: str,
        fields: Dict[str, Any],
        model_class: Optional[Type[T]] = None,
        user_id: Optional[str] = None,
        session_id: Optional[str] = None,
        is_canonical: bool = False,
    ) -> Optional[T]:
        """
        Find a document by multiple field values.

        Args:
            collection: Collection name
            fields: Dictionary of field name -> value pairs
            model_class: Pydantic model class for deserialization
            user_id: User ID (for runtime data)
            session_id: Session ID (for runtime data)
            is_canonical: Whether this is canonical data

        Returns:
            First matching document or None
        """
        # Apply legacy adapter first
        collection, _, fields = self._apply_legacy_adapter(collection, query=fields)
        
        if self._should_use_mongodb(collection, is_canonical):
            logger.debug(f"Routing find_by_fields to MongoDB: {collection} with {fields}")
            return await self._mongo_ops.find_by_fields(
                collection=collection, fields=fields, model_class=model_class
            )
        else:
            logger.debug(f"Routing find_by_fields to file system: {collection} with {fields}")
            return await self._file_db.find_by_fields_async(
                collection=collection,
                fields=fields,
                model_class=model_class,
                is_canonical=is_canonical,
            )

    async def find(
        self,
        collection: str,
        query: Dict[str, Any],
        model_class: Optional[Type[T]] = None,
        user_id: Optional[str] = None,
        is_canonical: bool = False,
        limit: Optional[int] = None,
    ) -> List[Dict[str, Any]]:
        """
        Find documents matching a query filter.

        Args:
            collection: Collection name
            query: Dictionary of field names and values to match (supports MongoDB operators)
            model_class: Pydantic model class for deserialization (optional)
            user_id: User ID (for runtime data)
            is_canonical: Whether this is canonical data
            limit: Maximum number of documents to return

        Returns:
            List of matching documents (as dicts if model_class not provided, else as model instances)
        """
        # Apply legacy adapter first
        collection, _, query = self._apply_legacy_adapter(collection, query=query)
        
        if self._should_use_mongodb(collection, is_canonical):
            logger.debug(f"Routing find to MongoDB: {collection} with query {query}")
            results = await self._mongo_ops.find(
                collection=collection,
                query=query,
                model_class=model_class,
                user_id=user_id,
                is_canonical=is_canonical,
                limit=limit,
            )
            # If model_class provided, results are already model instances
            if model_class:
                return results
            # Otherwise, convert to dicts
            return [result.model_dump(mode="json") if hasattr(result, "model_dump") else result for result in results]
        else:
            logger.debug(f"Routing find to file system: {collection} with query {query}")
            # Get results from file system (returns model instances if model_class provided)
            file_results = self._file_db.find(
                collection=collection,
                query=query,
                model_class=model_class,
                user_id=user_id,
                is_canonical=is_canonical,
                limit=limit,
            )
            # If model_class not provided, convert models to dicts
            if not model_class:
                return [item.model_dump(mode="json") if hasattr(item, "model_dump") else item for item in file_results]
            return file_results

    # Synchronous methods inherited from FallbackMixin for backward compatibility
