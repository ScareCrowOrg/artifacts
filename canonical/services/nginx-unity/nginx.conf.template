user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log ${LOG_LEVEL};
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    keepalive_timeout  65;

    # ── Upstream: Vite dev server (frontend) ─────────────────────────────────
    upstream vite_upstream {
        server ${VITE_UPSTREAM};
    }

    # ── Upstream: Backend API ─────────────────────────────────────────────────
    upstream backend_upstream {
        server ${BACKEND_UPSTREAM};
    }

    # ── Upstream: CentralHub ──────────────────────────────────────────────────
    upstream centralhub {
        server ${CENTRALHUB_UPSTREAM};
    }

    upstream frontend {
        server ${FRONTEND_UPSTREAM};
    }

    upstream scarerunner {
        server ${SCARERUNNER_UPSTREAM};
    }

    upstream gatekeeper {
        server ${GATEKEEPER_UPSTREAM};
    }

    # ── FQDN-aware server block (tunnel subdomain routing) ────────────────────
    # Routes ${NGINX_SERVER_NAME}/ → Vite frontend, /api → Backend.
    # NGINX_SERVER_NAME is set to the TUNNEL_FQDN by entrypoint.sh,
    # or falls back to "_" (nginx catch-all) when no FQDN is configured.
    server {
        listen ${NGINX_PORT};
        server_name ${NGINX_SERVER_NAME};

        # ── Backend API ───────────────────────────────────────────────────────
        location /api/ {
            proxy_pass         http://backend_upstream;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_set_header   X-Forwarded-Host  $host;
            proxy_set_header   Authorization     $http_authorization;
            proxy_read_timeout 300s;
        }

        # ── CentralHub API (legacy) ───────────────────────────────────────────
        location /centralhub/ {
            proxy_pass         http://centralhub/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_set_header   Authorization     $http_authorization;
            proxy_read_timeout 300s;
        }

        # ── GateKeeper ────────────────────────────────────────────────────────
        location /gatekeeper/ {
            proxy_pass         http://gatekeeper/;
            proxy_set_header   Host            $host;
            proxy_set_header   X-Real-IP       $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
        }

        # ── ScareRunner (internal) ────────────────────────────────────────────
        location /runner/ {
            proxy_pass         http://scarerunner/;
            proxy_set_header   Host            $host;
            proxy_set_header   X-Real-IP       $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
        }

        # ── Nginx health check (plain text – used by Docker HEALTHCHECK) ──────
        location /health {
            return 200 "OK";
            add_header Content-Type text/plain;
        }

        # ── Vite frontend (catch-all) ─────────────────────────────────────────
        # WebSocket upgrade headers enable Vite HMR over the tunnel.
        location / {
            proxy_pass         http://vite_upstream;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_set_header   X-Forwarded-Host  $host;

            # WebSocket upgrade (Vite HMR)
            proxy_http_version 1.1;
            proxy_set_header   Upgrade    $http_upgrade;
            proxy_set_header   Connection "upgrade";
        }
    }
}
