user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log ${LOG_LEVEL};
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    keepalive_timeout  65;

    upstream centralhub {
        server ${CENTRALHUB_UPSTREAM};
    }

    upstream frontend {
        server ${FRONTEND_UPSTREAM};
    }

    upstream scarerunner {
        server ${SCARERUNNER_UPSTREAM};
    }

    upstream gatekeeper {
        server ${GATEKEEPER_UPSTREAM};
    }

    server {
        listen ${NGINX_PORT};

        # ── CentralHub API ────────────────────────────────────────────────
        location /api/ {
            proxy_pass         http://centralhub;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   Authorization     $http_authorization;
            proxy_read_timeout 300s;
        }

        # ── GateKeeper ────────────────────────────────────────────────────
        location /gatekeeper/ {
            proxy_pass         http://gatekeeper/;
            proxy_set_header   Host            $host;
            proxy_set_header   X-Real-IP       $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
        }

        # ── ScareRunner (internal) ────────────────────────────────────────
        location /runner/ {
            proxy_pass         http://scarerunner/;
            proxy_set_header   Host            $host;
            proxy_set_header   X-Real-IP       $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
        }

        # ── Nginx health check (plain text – used by Docker HEALTHCHECK) ──
        location /health {
            return 200 "OK";
            add_header Content-Type text/plain;
        }

        # ── Frontend (catch-all) ──────────────────────────────────────────
        location / {
            proxy_pass       http://frontend;
            proxy_set_header Host            $host;
            proxy_set_header X-Real-IP       $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
