{
  "name": "scareverse-artifacts",
  "version": "1.0.0",
  "description": "Vite compilation service for ScareVerse dynamic cell types and book types",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0 --port 5052",
    "build": "vite build --config vite.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "vue": "^3.5.22",
    "pinia": "^3.0.4",
    "vue-i18n": "^9.14.5",
    "vue3-grid-layout-next": "^1.0.7",
    "markdown-it": "^13.0.0",
    "highlight.js": "^11.9.0",
    "@xterm/xterm": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@babylonjs/core": "^8.49.6",
    "@babylonjs/loaders": "^8.49.6",
    "@babylonjs/materials": "^8.49.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "msw": "^2.12.2",
    "@types/node": "^20.19.25",
    "tailwindcss": "3.3.3",
    "postcss": "8.4.31",
    "autoprefixer": "10.4.16",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/typography": "0.5.19"
  }
}
