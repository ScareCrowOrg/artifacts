# ═══════════════════════════════════════════════════════════════════════════
# Claude Code Service — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ── Service ───────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
CLAUDE_HOME=/app/claude-home

# ── Redis L1 (Heartbeat) ──────────────────────────────────────────────────
REDIS_L1_HOST=redis
REDIS_L1_PORT=6380
REDIS_L1_DB=0
REDIS_L1_PASSWORD=scarerunner
HEARTBEAT_INTERVAL=20
HEARTBEAT_TTL=60

# ═══════════════════════════════════════════════════════════════════════════
# Claude Code CLI Configuration
# ═══════════════════════════════════════════════════════════════════════════
# ANTHROPIC_API_KEY é OBRIGATÓRIA — sem ela o Claude Code não funciona.
# Obtenha sua API key em: https://console.anthropic.com/

# ── API Key (OBRIGATÓRIO) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Endpoint (default: DeepSeek Anthropic-compatible) ─────────────────────
# Altere para https://api.anthropic.com se quiser usar o endpoint oficial.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── Model Mapping (DeepSeek defaults) ─────────────────────────────────────
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro

# ── Session Model ─────────────────────────────────────────────────────────
ANTHROPIC_MODEL=deepseek-v4-flash

# ── Behavior ──────────────────────────────────────────────────────────────
CLAUDE_AUTO_COMPACT_PCT_OVERRIDE=95
