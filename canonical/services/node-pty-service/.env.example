# Node-PTY Service Environment Variables
# Copy to .env and fill in your values.

# Service configuration
PORT=8000
SESSION_TIMEOUT=3600
LOG_LEVEL=INFO
ARTIFACTS_PATH=/app/artifacts
SHELL=/bin/bash

# Redis L1 (GateKeeper service discovery heartbeat)
REDIS_L1_HOST=redis
REDIS_L1_PORT=6380
REDIS_L1_DB=0
REDIS_L1_PASSWORD=scarerunner
HEARTBEAT_INTERVAL=20
HEARTBEAT_TTL=60

# Optional: path to SSH keys directory for Git authentication
# SSH_KEYS_PATH=/home/user/.ssh
