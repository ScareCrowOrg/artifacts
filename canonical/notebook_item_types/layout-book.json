{
  "id": "layout-book",
  "name": "Layout Book",
  "description": "Save and restore complete workspace layouts including cell positions, grid configuration, and initialization data for both persistent and ephemeral cells",
  "version": "1.0.0",
  "category": "workspace",
  "can_render_dynamically": false,
  "default_refs": {
    "docs": [
      "docs/README.md"
    ]
  },
  "default_initial_data": {
    "layout_version": "1.0.0",
    "cells": [],
    "grid_config": {
      "cols": 12,
      "rowHeight": 30,
      "margin": [
        10,
        10
      ]
    },
    "metadata": {
      "cell_count": 0,
      "persistent_count": 0,
      "ephemeral_count": 0,
      "last_applied": null,
      "created_from_layout": true
    }
  },
  "allow_instance_override_refs": true,
  "properties_schema": {
    "layout_version": {
      "type": "string",
      "default": "1.0.0",
      "description": "Schema version for layout book data structure"
    },
    "cells": {
      "type": "array",
      "description": "Array of cell references with position and state information",
      "items": {
        "type": "object",
        "properties": {
          "cellId": {
            "type": "string",
            "description": "UUID of persistent cell (omit for ephemeral)"
          },
          "category": {
            "type": "string",
            "enum": [
              "persistent",
              "ephemeral"
            ],
            "description": "Cell category"
          },
          "type": {
            "type": "string",
            "description": "Cell type identifier"
          },
          "title": {
            "type": "string",
            "description": "Cell display title"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ]
          },
          "state": {
            "type": "object",
            "properties": {
              "isMinimized": {
                "type": "boolean"
              },
              "isMaximized": {
                "type": "boolean"
              }
            }
          },
          "initialization_data": {
            "type": "object",
            "description": "Initialization data for ephemeral cells"
          }
        },
        "required": [
          "category",
          "type",
          "title",
          "position",
          "state"
        ]
      }
    },
    "grid_config": {
      "type": "object",
      "description": "Grid layout configuration snapshot",
      "properties": {
        "cols": {
          "type": "integer"
        },
        "rowHeight": {
          "type": "integer"
        },
        "margin": {
          "type": "array"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Layout book metadata",
      "properties": {
        "cell_count": {
          "type": "integer"
        },
        "persistent_count": {
          "type": "integer"
        },
        "ephemeral_count": {
          "type": "integer"
        },
        "last_applied": {
          "type": "string",
          "format": "date-time"
        },
        "created_from_layout": {
          "type": "boolean"
        }
      }
    }
  },
  "_discovery": {
    "labels": [
      "#layout",
      "#book",
      "#organization",
      "#ui"
    ],
    "describe": "Book-type cell for organizing and layouting multiple cells in a structured workspace. Provides grid/flow layouts with drag-and-drop cell arrangement. Supports cell grouping, tabs, and collapsible sections. Enables creation of dashboards and multi-cell workflows. Instant layout operations with persistent configuration. Useful for creating complex multi-step workflows and dashboards.",
    "estimated_duration_seconds": 0,
    "required_resources": [],
    "dependencies": [],
    "tags": [
      "layout",
      "book",
      "workspace",
      "organization"
    ],
    "use_cases": [
      "Create multi-cell dashboards",
      "Organize complex workflows",
      "Build structured notebook layouts",
      "Design custom workspace arrangements"
    ]
  },
  "stage": "canonical"
}
