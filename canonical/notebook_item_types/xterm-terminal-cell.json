{
  "id": "xterm-terminal-cell",
  "name": "Terminal",
  "description": "Interactive terminal cell powered by xterm.js and Node-PTY Service. Provides persistent shell sessions over WebSocket for AI agent CLI tools (GeminiCLI, Claude Code, Aider, etc.).",
  "version": "1.0.0",
  "category": "infrastructure",
  "default_refs": {
    "basecell": [
      "frontend/xterm-terminal.ts"
    ],
    "view": [
      "frontend/View.vue"
    ],
    "scripts": [
      "backend/scripts/main.py"
    ],
    "docs": [
      "docs/README.md"
    ]
  },
  "default_initial_data": {
    "cols": 120,
    "rows": 40,
    "font_size": 14,
    "theme": "dark"
  },
  "allow_instance_override_refs": true,
  "properties_schema": {
    "ws_url": {
      "type": "string",
      "description": "WebSocket endpoint (auto-discovered if empty)"
    },
    "cols": {
      "type": "integer",
      "default": 120,
      "description": "Terminal column count"
    },
    "rows": {
      "type": "integer",
      "default": 40,
      "description": "Terminal row count"
    },
    "font_size": {
      "type": "integer",
      "default": 14,
      "description": "Terminal font size in pixels"
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ],
      "default": "dark",
      "description": "Terminal color theme"
    }
  },
  "can_render_dynamically": true,
  "_discovery": {
    "labels": [
      "#terminal",
      "#pty",
      "#shell",
      "#infrastructure",
      "#ai-agents"
    ],
    "describe": "Interactive terminal cell powered by xterm.js. Connects to the Node-PTY Service over WebSocket to provide persistent shell sessions. Serves as shared terminal infrastructure for AI agent CLI tools (GeminiCLI, Claude Code, Aider, OpenInterpreter). Supports Git operations, file system manipulation, and arbitrary command execution.",
    "estimated_duration_seconds": 0,
    "required_resources": [
      "node-pty-service"
    ],
    "dependencies": [
      "node-pty-service"
    ],
    "tags": [
      "terminal",
      "pty",
      "shell",
      "websocket",
      "xterm",
      "infrastructure",
      "ai-agents"
    ],
    "use_cases": [
      "Interactive shell access from the cockpit",
      "Git operations (clone, status, log) via CLI",
      "AI agent command execution (GeminiCLI, Claude Code)",
      "File system manipulation via terminal",
      "Script execution and debugging"
    ]
  },
  "stage": "canonical"
}
