{
  "id": "content-manager-cell",
  "name": "Content Manager",
  "description": "Content management utility with Cloudflare R2 storage. Ephemeral utility cell that provides list, load, and persist operations for typed content assets (images, vectors, 3D models). Cell instances are ephemeral, but managed content is persistent.",
  "version": "1.0.0",
  "category": "content-management",
  "can_render_dynamically": true,
  "default_refs": {
    "view": ["frontend/View.vue"],
    "docs": ["docs/README.md"],
    "backend": ["backend/scripts/main.py"],
    "storage": ["backend/scripts/storage.py"],
    "utils": ["backend/scripts/utils.py"],
    "basecell": ["frontend/ContentManagerCell.ts"]
  },
  "default_initial_data": {
    "show_persistence_form": false,
    "default_content_type_id": null,
    "filters": {
      "content_type_id": null,
      "assignee_id": null,
      "tags": [],
      "is_latest": true
    },
    "pagination": {
      "limit": 20,
      "offset": 0
    },
    "category": "ephemeral",
    "icon": "📦"
  },
  "allow_instance_override_refs": true,
  "properties_schema": {
    "category": {
      "type": "string",
      "default": "ephemeral",
      "description": "Cell category - 'ephemeral' marks this as ephemeral utility (not persisted)"
    }
  }
}
