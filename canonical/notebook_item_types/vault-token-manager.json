{
  "id": "vault-token-manager",
  "name": "Vault Token Manager",
  "description": "Secure interface for managing encrypted tokens in the Wasm Sidecar Vault",
  "default_refs": {
    "view": [
      "frontend/View.vue"
    ],
    "docs": [
      "docs/README.md"
    ]
  },
  "default_initial_data": {
    "autoLockEnabled": true,
    "showExpired": false,
    "sortBy": "createdAt",
    "sortOrder": "desc"
  },
  "allow_instance_override_refs": false,
  "can_render_dynamically": true
}
