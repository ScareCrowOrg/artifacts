{
  "id": "settings-panel-cell",
  "name": "Settings Panel",
  "version": "1.0.0",
  "description": "Manage user and global application settings with conditional RBAC protection",
  "category": "system",
  "tags": ["settings", "configuration", "rbac", "theme", "oauth"],
  "author": "ScareVerse",
  "can_render_dynamically": true,
  "default_refs": {
    "view": ["frontend/View.vue"],
    "basecell": ["frontend/SettingsPanelCell.ts"]
  },
  "permissions": {
    "required": [],
    "optional": ["settings:admin"]
  },
  "inputs": {
    "action": {
      "type": "enum",
      "required": true,
      "values": ["get", "update"],
      "description": "Action to perform (get or update settings)"
    },
    "scope": {
      "type": "enum",
      "required": true,
      "values": ["user", "global"],
      "description": "Scope of settings (user or global)"
    },
    "settings": {
      "type": "object",
      "required": false,
      "description": "Settings data for update action"
    }
  },
  "outputs": {
    "success": {
      "type": "boolean",
      "description": "Whether the operation succeeded"
    },
    "action": {
      "type": "string",
      "description": "The action that was performed"
    },
    "data": {
      "type": "object",
      "description": "Settings data (for get action) or updated settings (for update action)"
    },
    "error": {
      "type": "string",
      "description": "Error message if operation failed"
    }
  },
  "features": {
    "user_settings": true,
    "global_settings": true,
    "theme_management": true,
    "oauth_configuration": true,
    "rbac_protected": true
  }
}
