{
  "id": "redis-explorer",
  "name": "redis-explorer",
  "description": "Hierarchical Redis key explorer with interactive navigation, inspection, and management capabilities for debugging and observability",
  "version": "1.0.0",
  "category": "debugging",
  "can_render_dynamically": true,
  "default_refs": {
    "basecell": [
      "frontend/RedisExplorerCell.ts"
    ],
    "view": [
      "frontend/View.vue"
    ],
    "scripts": [
      "backend/scripts/main.py"
    ],
    "docs": [
      "docs/README.md"
    ]
  },
  "default_initial_data": {
    "category": "ephemeral",
    "title": "Redis Explorer",
    "current_prefix": "",
    "delimiter": ":",
    "max_depth": 1,
    "action": "info"
  },
  "allow_instance_override_refs": true,
  "properties_schema": {
    "category": {
      "type": "string",
      "default": "ephemeral",
      "description": "Cell category - ephemeral (not persisted to database)"
    },
    "title": {
      "type": "string",
      "default": "Redis Explorer",
      "description": "Cell title"
    },
    "current_prefix": {
      "type": "string",
      "default": "",
      "description": "Current Redis key prefix being explored"
    },
    "delimiter": {
      "type": "string",
      "default": ":",
      "description": "Delimiter for hierarchical structure"
    },
    "max_depth": {
      "type": "integer",
      "default": 1,
      "description": "Maximum depth levels to display"
    },
    "action": {
      "type": "string",
      "default": "info",
      "enum": [
        "info",
        "scan",
        "get",
        "delete"
      ],
      "description": "Default action to perform"
    }
  },
  "_discovery": {
    "labels": [
      "#redis",
      "#database",
      "#utility",
      "#debug"
    ],
    "describe": "Redis database explorer and management utility. Provides key-value browsing, search, and inspection capabilities. Supports all Redis data types (strings, lists, sets, hashes, sorted sets). Includes commands execution console and TTL management. Real-time key monitoring with pub/sub visualization. Fast queries (~100-500ms depending on key count). Useful for debugging application state, inspecting cache data, and managing Redis-backed workflows.",
    "estimated_duration_seconds": 1,
    "required_resources": [
      "redis"
    ],
    "dependencies": [],
    "tags": [
      "redis",
      "database",
      "debug",
      "exploration"
    ],
    "use_cases": [
      "Inspect Redis cache data",
      "Debug application state",
      "Monitor pub/sub messages",
      "Manage Redis keys and values"
    ]
  },
  "kind": "cell",
  "updated_at": "2026-03-08T00:00:00",
  "created_at": "2026-02-24T00:00:00",
  "stage": "canonical"
}
