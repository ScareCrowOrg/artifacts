{
  "id": "coder-cell",
  "name": "coder-cell",
  "description": "Autonomous code generation cell that creates new cells using Aider + Qwen based on validated plans from PlannerCell, with TypeScript/JSON validation and automatic registry updates",
  "version": "1.0.0",
  "category": "code-generation",
  "can_render_dynamically": true,
  "default_refs": {
    "view": [
      "frontend/View.vue"
    ],
    "scripts": [
      "backend/scripts/main.py"
    ],
    "docs": [
      "docs/README.md"
    ],
    "types": [
      "frontend/types.ts"
    ]
  },
  "default_initial_data": {
    "category": "ephemeral",
    "plan": null,
    "context": {
      "repo_structure": "",
      "example_cells": [],
      "constraints": []
    },
    "files_created": [],
    "validation": {
      "passed": false,
      "errors": []
    },
    "status": "idle",
    "icon": "⚙️"
  },
  "allow_instance_override_refs": true,
  "properties_schema": {
    "category": {
      "type": "string",
      "default": "ephemeral",
      "description": "Cell category - 'ephemeral' marks this as ephemeral (not persisted)"
    },
    "plan": {
      "type": [
        "object",
        "null"
      ],
      "default": null,
      "description": "Validated plan from PlannerCell containing DAG definition"
    },
    "context": {
      "type": "object",
      "default": {
        "repo_structure": "",
        "example_cells": [],
        "constraints": []
      },
      "description": "Context for code generation",
      "properties": {
        "repo_structure": {
          "type": "string",
          "description": "Repository structure context"
        },
        "example_cells": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Example cells to use as reference"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Constraints to follow during generation"
        }
      }
    },
    "files_created": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of file paths that were created"
    },
    "validation": {
      "type": "object",
      "default": {
        "passed": false,
        "errors": []
      },
      "description": "Validation results for generated code",
      "properties": {
        "passed": {
          "type": "boolean",
          "description": "Whether validation passed"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of validation errors"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "generating",
        "validating",
        "registering",
        "completed",
        "failed"
      ],
      "default": "idle",
      "description": "Current status of the code generation process"
    },
    "icon": {
      "type": "string",
      "default": "⚙️",
      "description": "Icon representing the cell"
    }
  },
  "_discovery": {
    "labels": [
      "#code-generation",
      "#automation",
      "#ai-driven",
      "#validation"
    ],
    "describe": "Autonomous code generation cell that creates new cells based on specifications from PlannerCell. Uses Aider + Qwen (via aider-worker) to generate type.json definitions, TypeScript Cell implementations, and Vue view components. Performs TypeScript compilation validation and JSON schema validation. Automatically updates CellRegistry after successful generation. Follows existing cell patterns and conventions.",
    "estimated_duration_seconds": 60,
    "required_resources": [
      "aider-worker",
      "typescript-compiler",
      "cell-registry"
    ],
    "dependencies": [
      "aider-worker",
      "cell-registry"
    ],
    "tags": [
      "code-generation",
      "automation",
      "validation",
      "aider"
    ],
    "use_cases": [
      "Generate missing cells identified by PlannerCell",
      "Create type.json definitions following schema",
      "Generate TypeScript Cell implementations using BaseCell interface",
      "Generate Vue view components with proper structure",
      "Validate generated code (TypeScript + JSON)",
      "Update CellRegistry with newly created cells"
    ]
  },
  "stage": "canonical"
}
