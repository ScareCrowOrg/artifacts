{
  "id": "vault-manager",
  "name": "vault-manager",
  "description": "CRUD interface for managing encrypted secrets stored in the launcher vault",
  "version": "1.0.0",
  "category": "security",
  "default_refs": {
    "view": [
      "frontend/View.vue"
    ],
    "scripts": [
      "backend/scripts/main.py"
    ],
    "docs": [
      "docs/README.md"
    ]
  },
  "default_initial_data": {
    "currentTab": "list",
    "auditFilters": {}
  },
  "allow_instance_override_refs": false,
  "can_render_dynamically": true,
  "permissions": {
    "required": [],
    "optional": ["secrets:manage", "secrets:audit"]
  },
  "inputs": {
    "action": {
      "type": "enum",
      "values": ["list", "create", "rotate", "delete", "audit"],
      "description": "Vault operation to perform"
    },
    "payload": {
      "type": "object",
      "description": "Operation-specific data"
    },
    "service": {
      "type": "string",
      "default": "launcher",
      "description": "Target service owning the vault"
    }
  },
  "outputs": {
    "secrets": {
      "type": "array",
      "description": "List of secrets with masked values"
    },
    "audit": {
      "type": "array",
      "description": "Audit trail entries"
    }
  },
  "_discovery": {
    "labels": [
      "#security",
      "#secrets",
      "#vault",
      "#admin",
      "#crud"
    ],
    "describe": "Administrative cell for managing secrets stored in the launcher vault. Supports creating, rotating and deleting secrets with AES-256-GCM encryption. All values are masked in the UI. Audit trail tracks every access. Integrates with Phase 2 TOTP validation and Redis L1 cache.",
    "estimated_duration_seconds": 1,
    "required_resources": [],
    "dependencies": [],
    "tags": [
      "security",
      "secrets",
      "vault",
      "crud",
      "admin",
      "audit"
    ],
    "use_cases": [
      "Create and manage application secrets",
      "Rotate secrets with audit trail",
      "View access history for secrets",
      "Delete unused secrets securely"
    ]
  },
  "kind": "cell",
  "created_at": "2026-03-14T00:00:00",
  "updated_at": "2026-03-14T00:00:00"
}
