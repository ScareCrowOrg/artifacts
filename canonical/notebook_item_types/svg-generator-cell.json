{
  "id": "svg-generator-cell",
  "name": "SVG Generator Cell",
  "description": "BaseCell-compliant cell for generating SVG visualizations from text prompts using AI. Implements standardized execution interface with fallback mechanism.",
  "version": "2.0.0",
  "category": "visualization",
  "can_render_dynamically": true,
  "base_cell_compliant": true,
  "default_refs": {
    "basecell": ["frontend/SvgGeneratorCell.ts"],
    "view": ["frontend/View.vue"],
    "scripts": ["backend/scripts/main.py"],
    "docs": ["docs/README.md"],
    "tests": ["frontend/tests/SvgGeneratorCell.test.ts"]
  },
  "default_initial_data": {
    "category": "visualization",
    "prompt": "",
    "generatedSvg": null,
    "isGenerating": false,
    "error": null,
    "selectedModel": "mistral"
  },
  "allow_instance_override_refs": true,
  "properties_schema": {
    "category": {
      "type": "string",
      "default": "visualization",
      "description": "Cell category - 'visualization' for SVG generation cells"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Text description of the desired SVG visualization"
    },
    "generatedSvg": {
      "type": ["string", "null"],
      "default": null,
      "description": "Generated SVG markup code"
    },
    "isGenerating": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicating if SVG generation is in progress"
    },
    "error": {
      "type": ["string", "null"],
      "default": null,
      "description": "Error message if generation fails"
    },
    "selectedModel": {
      "type": "string",
      "default": "mistral",
      "description": "Currently selected LLM model for generation"
    }
  }
}
