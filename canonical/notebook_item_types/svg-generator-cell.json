{
  "id": "svg-generator-cell",
  "name": "SVG Generator Cell",
  "description": "Interactive cell for generating SVG visualizations from text prompts using AI",
  "version": "1.0.0",
  "category": "visualization",
  "can_render_dynamically": false,
  "default_refs": {
    "view": ["frontend/View.vue"],
    "scripts": ["backend/scripts/main.py"],
    "docs": ["docs/README.md"]
  },
  "default_initial_data": {
    "category": "ephemeral",
    "prompt": "",
    "generatedSvg": null,
    "isGenerating": false,
    "error": null
  },
  "allow_instance_override_refs": true,
  "properties_schema": {
    "category": {
      "type": "string",
      "default": "ephemeral",
      "description": "Cell category - 'ephemeral' marks this as ephemeral (not persisted)"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Text description of the desired SVG visualization"
    },
    "generatedSvg": {
      "type": ["string", "null"],
      "default": null,
      "description": "Generated SVG markup code"
    },
    "isGenerating": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicating if SVG generation is in progress"
    },
    "error": {
      "type": ["string", "null"],
      "default": null,
      "description": "Error message if generation fails"
    }
  }
}
