{
  "id": "issues-dashboard-cell",
  "name": "Issues Dashboard",
  "version": "1.0.0",
  "description": "Manage GitHub issues and project tasks with RBAC protection",
  "category": "admin",
  "can_render_dynamically": true, 
  "author": "ScareVerse",
  "icon": "📋",
  "requires_backend": true,
  "requiredPermissions": ["issues:read"],
  "optionalPermissions": ["issues:write"],
  "tags": ["admin", "issues", "dashboard", "rbac"],
  "default_refs": {
    "view": [
      "frontend/View.vue"
    ],
    "basecell": [
      "frontend/IssuesDashboardCell.ts"
    ]
  },
  "properties_schema": {
    "action": {
      "type": "enum",
      "label": "Action",
      "description": "Action to perform",
      "required": true,
      "values": ["list", "get", "create", "update", "delete"],
      "default": "list"
    },
    "issueId": {
      "type": "string",
      "label": "Issue ID",
      "description": "ID of the issue (required for get, update, delete)",
      "required": false
    },
    "filters": {
      "type": "object",
      "label": "Filters",
      "description": "Filter options for list action",
      "required": false,
      "properties": {
        "status": {
          "type": "string",
          "label": "Status",
          "description": "Filter by status"
        },
        "assignee": {
          "type": "string",
          "label": "Assignee",
          "description": "Filter by assignee"
        },
        "labels": {
          "type": "array",
          "label": "Labels",
          "description": "Filter by labels",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "label": "Data",
      "description": "Data payload for create/update actions",
      "required": false
    }
  },
  "inputs": [
    {
      "name": "action",
      "type": "enum",
      "required": true,
      "values": ["list", "get", "create", "update", "delete"]
    },
    {
      "name": "issueId",
      "type": "string",
      "required": false
    },
    {
      "name": "filters",
      "type": "object",
      "required": false
    },
    {
      "name": "data",
      "type": "object",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "success",
      "type": "boolean"
    },
    {
      "name": "action",
      "type": "string"
    },
    {
      "name": "data",
      "type": "object"
    }
  ]
}
