{
  "name": "ollama_chat",
  "version": "2.1.0",
  "description": "LLM chat inference via Ollama service",

  "queue_type": "cpu",

  "execution_model": "subprocess",

  "worker": {
    "type": "job",
    "path": "artifacts/canonical/workers/ollama-wrapper",
    "entry_point": "worker.py",
    "python_version": "3.11+"
  },

  "configuration": {
    "timeout_seconds": 120
  },

  "queue": "scareverse:ollama-jobs:queue",
  "queue_l1": "scareverse:ollama-jobs:queue",
  "queue_l2": "scareverse:ollama-jobs:queue",
  "result_storage": "rpush_l1",
  "result_key_prefix": "scareverse:ollama-results",
  "result_key_ttl": 60,
  "timeout": 120,

  "dependencies": [
    "ollama"
  ],

  "worker_availability_key": "state:worker:ollama_chat:available",

  "aliases": [
    "ollama_chat"
  ],

  "input_schema": {
    "type": "object",
    "required": ["messages"],
    "properties": {
      "messages": {"type": "array", "items": {"type": "object"}},
      "model": {"type": "string", "default": "mistral"},
      "stream": {"type": "boolean", "default": false},
      "options": {"type": "object"}
    }
  },

  "output_schema": {
    "type": "object",
    "properties": {
      "message": {"type": "object"},
      "model": {"type": "string"},
      "done": {"type": "boolean"}
    }
  }
}
