{
  "name": "instantmesh",
  "job_type": "instantmesh",
  "description": "3D mesh generation via InstantMesh service",
  "worker": "instantmesh",
  "worker_type": "instantmesh",
  "endpoint": "http://scareverse-worker-instantmesh:8000",
  "queue": "scareverse:3d-jobs:queue",
