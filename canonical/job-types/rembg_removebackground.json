{
  "name": "rembg_removebackground",
  "version": "2.1.0",
  "description": "Background removal via rembg subprocess worker",

  "queue_type": "cpu",

  "execution_model": "subprocess",

  "worker": {
    "type": "job",
    "path": "artifacts/canonical/workers/rembg",
    "entry_point": "main.py",
    "python_version": "3.11+"
  },

  "configuration": {
    "timeout_seconds": 60,
    "memory_limit_mb": 2048,
    "requires_gpu": false,
    "requires_internet": false
  },

  "queue": "scareverse:rembg-jobs:queue",
  "queue_l1": "scareverse:rembg-jobs:queue",
  "queue_l2": "scareverse:rembg-jobs:queue",
  "result_storage": "rpush_l1",
  "result_key_prefix": "scareverse:rembg-results",
  "result_key_ttl": 120,

  "dependencies": [],

  "worker_availability_key": "state:worker:rembg_removebackground:available",

  "aliases": [
    "REMOTE_REMBG",
    "background_removal",
    "rembg_removebackground"
  ],

  "input_schema": {
    "type": "object",
    "required": ["image_base64"],
    "properties": {
      "image_base64": {"type": "string", "description": "Base64-encoded input image"},
      "model": {"type": "string", "default": "u2net"},
      "alpha_matting": {"type": "boolean", "default": true}
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["image_base64"],
    "properties": {
      "image_base64": {"type": "string", "description": "Base64-encoded PNG with transparent background"}
    }
  }
}
