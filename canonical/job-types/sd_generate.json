{
  "name": "sd_generate",
  "version": "2.1.0",
  "description": "Image generation via Stable Diffusion service",

  "queue_type": "gpu",

  "execution_model": "subprocess",

  "worker": {
    "type": "job",
    "path": "artifacts/canonical/workers/stable-diffusion-wrapper",
    "entry_point": "main.py",
    "python_version": "3.11+"
  },

  "configuration": {
    "timeout_seconds": 300
  },

  "queue": "scareverse:sd-jobs:queue",
  "queue_l1": "scareverse:sd-jobs:queue",
  "queue_l2": "scareverse:sd-jobs:queue",
  "result_storage": "rpush_l1",
  "result_key_prefix": "scareverse:sd-results",
  "result_key_ttl": 120,
  "timeout": 300,

  "dependencies": [
    "stable-diffusion"
  ],

  "worker_availability_key": "state:worker:sd_generate:available",

  "aliases": [
    "sd_generate"
  ],

  "input_schema": {
    "type": "object",
    "required": ["prompt"],
    "properties": {
      "prompt": {"type": "string"},
      "negative_prompt": {"type": "string", "default": ""},
      "model": {"type": "string", "default": "stabilityai/stable-diffusion-xl-base-1.0"},
      "width": {"type": "integer", "default": 512},
      "height": {"type": "integer", "default": 512},
      "num_inference_steps": {"type": "integer", "default": 20},
      "guidance_scale": {"type": "number", "default": 7.5}
    }
  },

  "output_schema": {
    "type": "object",
    "properties": {
      "image_base64": {"type": "string"},
      "seed": {"type": "integer"}
    }
  }
}
