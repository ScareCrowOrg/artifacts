{
  "id": "log-toggle-cell",
  "name": "Log Toggle Cell",
  "description": "Temporarily enable/disable specific log namespaces during a session for debugging and analysis",
  "version": "1.0.0",
  "category": "debugging",
  "default_refs": {
    "scripts": [
      "backend/scripts/main.py"
    ],
    "view": [
      "frontend/View.vue"
    ],
    "docs": [
      "docs/README.md"
    ]
  },
  "default_initial_data": {
    "enabled_namespaces": [],
    "debug_pattern": ""
  },
  "allow_instance_override_refs": true,
  "properties_schema": {
    "enabled_namespaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of log namespaces currently enabled"
    },
    "debug_pattern": {
      "type": "string",
      "default": "",
      "description": "Current DEBUG pattern (e.g., 'auth:*', 'api,store')"
    }
  },
  "can_render_dynamically": false
}
