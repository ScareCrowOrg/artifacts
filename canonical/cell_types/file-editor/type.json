{
  "id": "file-editor-v2",
  "name": "File Editor",
  "description": "Edit text files and code with syntax highlighting and save functionality",
  "version": "2.0.0",
  "category": "editor",
  "icon": "file-code",
  "default_refs": {
    "view": ["frontend/View.vue"],
    "docs": ["docs/README.md"]
  },
  "default_initial_data": {
    "fileName": "untitled.md",
    "filePath": "docs",
    "language": "markdown",
    "readOnly": false
  },
  "allow_instance_override_refs": true,
  "properties_schema": {
    "fileName": {
      "type": "string",
      "description": "Name of the file being edited",
      "required": true
    },
    "filePath": {
      "type": "string",
      "description": "Path to the file (folder)",
      "default": ""
    },
    "language": {
      "type": "string",
      "description": "Programming language for syntax highlighting",
      "default": "text"
    },
    "readOnly": {
      "type": "boolean",
      "description": "Whether the file is read-only",
      "default": false
    }
  }
}
