{
  "id": "3d-mesh-prototyping-cell",
  "name": "3D Mesh Prototyping Cell",
  "description": "Volumetric pipeline for generating real 3D meshes with 360º volume from single images using AI-powered reconstruction",
  "version": "1.0.0",
  "category": "prototyping",
  "can_render_dynamically": true,
  "default_refs": {
    "view": ["frontend/View.vue"],
    "scripts": ["backend/scripts/main.py"],
    "docs": ["docs/README.md"]
  },
  "default_initial_data": {
    "category": "ephemeral",
    "inputImage": null,
    "generatedMesh": null,
    "meshMetadata": null,
    "isGenerating": false,
    "error": null,
    "reconstructionParams": {
      "targetFaces": 50000,
      "enableDracoCompression": true,
      "compressionLevel": 7,
      "targetFileSizeMB": 5
    },
    "viewportSettings": {
      "autoRotate": true,
      "wireframeMode": false,
      "showGrid": true,
      "cameraPosition": [0, 1, 3]
    }
  },
  "allow_instance_override_refs": true,
  "properties_schema": {
    "category": {
      "type": "string",
      "default": "ephemeral",
      "description": "Cell category - 'ephemeral' marks this as ephemeral (not persisted)"
    },
    "inputImage": {
      "type": ["string", "null"],
      "default": null,
      "description": "Base64-encoded PNG input image for 3D reconstruction"
    },
    "generatedMesh": {
      "type": ["string", "null"],
      "default": null,
      "description": "Generated GLB mesh data (base64 or URL)"
    },
    "meshMetadata": {
      "type": ["object", "null"],
      "default": null,
      "description": "Metadata about the generated mesh (vertices, faces, file size, etc.)"
    },
    "isGenerating": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicating if 3D reconstruction is in progress"
    },
    "error": {
      "type": ["string", "null"],
      "default": null,
      "description": "Error message if reconstruction fails"
    },
    "reconstructionParams": {
      "type": "object",
      "default": {
        "targetFaces": 50000,
        "enableDracoCompression": true,
        "compressionLevel": 7,
        "targetFileSizeMB": 5
      },
      "description": "Parameters for 3D reconstruction and optimization"
    },
    "viewportSettings": {
      "type": "object",
      "default": {
        "autoRotate": true,
        "wireframeMode": false,
        "showGrid": true,
        "cameraPosition": [0, 1, 3]
      },
      "description": "Three.js viewport display settings"
    }
  }
}
